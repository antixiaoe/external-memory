# ===== 本地脚本用（.env，不进 git）=====

# 硅基流动 API Key（console: https://cloud.siliconflow.cn/account/ak）
SILICONFLOW_API_KEY=

# Supabase 数据库连接串（Dashboard → Project Settings → Database → Connection string → URI）
# 形如: postgresql://postgres:<密码>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL=

# MCP endpoint（部署后得到）
MCP_URL=https://<project-ref>.supabase.co/functions/v1/mcp

# 冒烟测试用的两把 token（值必须与 OP_TOKENS 里的配置一致）
TOKEN_HUMAN=tok_dev_human
TOKEN_AGENT=tok_dev_agent

# ===== Edge Function 环境变量用（.env.functions，通过 npm run secrets 上传）=====
# OP_TOKENS 格式: token=kind:name:scope，多个逗号分隔
#   human:<subject>        人只能访问自己
#   agent:<name>:*         agent 可访问任意 subject
#   agent:<name>:a|b       agent 仅可访问白名单
OP_TOKENS=tok_dev_human=human:liuxiaoyi,tok_dev_agent=agent:sales-agent:*
